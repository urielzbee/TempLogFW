/ {
    chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
	};

    aliases {
        led0 = &myled0;
        led1 = &myled1;

        btn1 = &mybtn1;

        rtc1 = &rtc;
    };

    leds {
        compatible = "gpio-leds";
        myled0: led_0 {
            gpios = <&gpioa 12 GPIO_ACTIVE_HIGH>;
        };
        myled1: led_1 {
            gpios = <&gpioa 11 GPIO_ACTIVE_HIGH>;
        };
    };      

    gpio_keys {
		compatible = "gpio-keys";
		mybtn1: btn_1 {
			gpios = <&gpiob 9 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};
&i2c2 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    tmp1075@48 {
        compatible = "ti,tmp1075";
        reg = <0x48>;
        conversion-rate = <220000>;
        consecutive-fault-measurements = <4>;
    };
};
&rtc {
    status = "okay";
    prescaler = <1>;
    clocks = <&rcc STM32_CLOCK(APB1, 28U)>,
            <&rcc STM32_SRC_LSE RTC_SEL(1)>;
};

&clk_lse {
    status = "okay";
};
&clk_lsi {
    status = "okay";
};
